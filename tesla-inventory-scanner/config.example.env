# Copy to .env (local) or set as GitHub Actions secrets / vars.

# --- Telegram (required for notifications) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Market (defaults target Taiwan new inventory) ---
TESLA_MARKET=TW
TESLA_LANGUAGE=zh_TW
TESLA_SUPER_REGION=asia pacific
TESLA_CONDITION=new

# Comma-separated models: my, m3, ms, mx
TESLA_MODELS=my,m3

# RWD trim codes per model (JSON object). Leave empty to use built-in defaults:
#   my → MYRWD
#   m3 → M3RWD,LRRWD
# TESLA_TRIMS={"my":["MYRWD"],"m3":["M3RWD","LRRWD"]}

# Optional location filters (miles/km depending on market). 0 = nationwide.
TESLA_ZIP=
TESLA_RANGE=0

# Max cars to fetch per model query
TESLA_COUNT=50

# --- Optional anti-bot helpers ---
# Paste a Cookie header copied from a logged-in browser session on tesla.com
# (DevTools → Network → inventory-results request → Request Headers → cookie)
TESLA_COOKIE=

# HTTP(S) proxy, e.g. http://user:pass@host:port
HTTPS_PROXY=
HTTP_PROXY=

# Path for seen-VIN state (GitHub Actions uses Actions cache + this file)
STATE_FILE=data/seen_vins.json

# Notify even when nothing new (heartbeat). Default: false
NOTIFY_ON_EMPTY=false

# Notify on scan errors. Default: true
NOTIFY_ON_ERROR=true
